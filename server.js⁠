// Schema for user account data sync
const userSchema = new mongoose.Schema({
  username: { type: String, unique: true },
  data: Object
});
const UserAccount = mongoose.model('UserAccount', userSchema);

io.on('connection', (socket) => {
  console.log('A user connected via WebSocket');

  socket.on('get-user-data', async ({ username }) => {
    try {
      const userDoc = await UserAccount.findOne({ username });
      socket.emit('load-user-data', userDoc ? userDoc.data : null);
    } catch (e) {
      console.error(e);
    }
  });

  socket.on('save-user-data', async ({ username, data }) => {
    try {
      await UserAccount.findOneAndUpdate(
        { username },
        { data },
        { upsert: true, new: true }
      );
      socket.broadcast.emit('user-data-updated', { username, data });
    } catch (e) {
      console.error(e);
    }
  });
});

