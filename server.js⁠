// Schemas with case-insensitivity and trimming to fix cross-device login bugs
const userSchema = new mongoose.Schema({
  username: { type: String, required: true, unique: true, lowercase: true, trim: true },
  pin: { type: String, required: true, trim: true },
  balance: { type: Number, default: 0 },
  isAdmin: { type: Boolean, default: false }
});

const transactionSchema = new mongoose.Schema({
  userId: mongoose.Schema.Types.ObjectId,
  username: { type: String, lowercase: true, trim: true },
  type: String, // 'Credit' or 'Debit'
  amount: Number,
  description: String,
  date: { type: Date, default: Date.now }
});

const User = mongoose.model('User', userSchema);
const Transaction = mongoose.model('Transaction', transactionSchema);

app.use(express.urlencoded({ extended: true }));
app.use(express.json());

// Serve static files (like style.css) from the root folder
app.use(express.static(path.join(__dirname)));

// Support email destination
const SUPPORT_EMAIL = "support@yourbankdomain.com";

// Routes for Static HTML Files
app.get('/', (req, res) => {
    res.sendFile(path.join(__dirname, 'index.html'));
});

// Handle Login Action (Sanitized for cross-device consistency)
app.post('/login', async (req, res) => {
    const username = req.body.username ? req.body.username.trim().toLowerCase() : '';
    const pin = req.body.pin ? req.body.pin.trim() : '';
    
    try {
        const user = await User.findOne({ username, pin });
        if (!user) {
            return res.send(`<h3>Invalid credentials. <a href="/">Try Again</a></h3>`);
        }
        
        if (user.isAdmin) {
            res.redirect(`/admin-panel?user=${user.username}`);
        } else {
            res.redirect(`/user-dashboard?user=${user.username}`);
        }
    } catch (err) {
        res.status(500).send('Server Error');
    }
});

// Handle Registration Action (Sanitized)
app.post('/register', async (req, res) => {
    const username = req.body.username ? req.body.username.trim().toLowerCase() : '';
    const pin = req.body.pin ? req.body.pin.trim() : '';

    if (!username || !pin) {
        return res.send(`<h3>Username and PIN are required. <a href="/">Back</a></h3>`);
    }

    try {
        const existing = await User.findOne({ username });
        if (existing) {
            return res.send(`<h3>Username already taken. <a href="/">Back</a></h3>`);
        }
        
        await User.create({ username, pin, balance: 0, isAdmin: false });
        res.send(`<h3>Account created successfully! <a href="/">Login now</a></h3>`);
    } catch (err) {
        res.status(500).send('Server Error');
    }
});

// Fetch Client Data API for Dashboard
app.get('/api/user-data', async (req, res) => {
    const username = req.query.user ? req.query.user.trim().toLowerCase() : '';
    if (!username) return res.status(400).json({ error: 'Unauthorized' });

    try {
        const user = await User.findOne({ username });
        if (!user) return res.status(404).json({ error: 'User not found' });

        const transactions = await Transaction.find({ username }).sort({ date: -1 });
        res.json({ username: user.username, balance: user.balance, transactions, supportEmail: SUPPORT_EMAIL });
    } catch (err) {
        res.status(500).json({ error: 'Server error' });
    }
});

// Fetch Admin Data API
app.get('/api/admin-data', async (req, res) => {
    try {
        const users = await User.find({ isAdmin: false });
        const transactions = await Transaction.find().sort({ date: -1 }).limit(30);
        res.json({ users, transactions });
    } catch (err) {
        res.status(500).json({ error: 'Server error' });
    }
});

// Admin Actions
app.post('/admin/update-balance', async (req, res) => {
    const { userId, newBalance } = req.body;
    await User.findByIdAndUpdate(userId, { balance: parseFloat(newBalance) });
    res.redirect('back');
});

app.post('/admin/send-transaction', async (req, res) => {
    const { username, type, amount, description } = req.body;
    const cleanUsername = username.trim().toLowerCase();
    const val = parseFloat(amount);
    
    await Transaction.create({ username: cleanUsername, type, amount: val, description });

    const user = await User.findOne({ username: cleanUsername });
    if (user) {
        user.balance = type === 'Credit' ? user.balance + val : user.balance - val;
        await user.save();
    }
    res.redirect('back');
});

app.post('/admin/edit-transaction', async (req, res) => {
    const { txId, newDescription } = req.body;
    await Transaction.findByIdAndUpdate(txId, { description: newDescription });
    res.redirect('back');
});

